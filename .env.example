# Optional. Copy to .env.local. Start the local API and Vite in separate shells.
PORT=3001
NODE_ENV=development
# Leave the following UNSET for offline development (readiness will be 503).
# SUPABASE_URL=http://127.0.0.1:54321
# SUPABASE_ANON_KEY=<local-publishable-or-anon-key>
# LOCAL_DIAGNOSTIC_TOKEN=<private-random-secret-at-least-32-characters>
# Never set a service-role, payment or browser-exposed secret for this application.
