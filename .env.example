# Optional. Copy to .env.local. Start the local API and Vite in separate shells.
# This file is inert documentation: it contains no credentials and is never loaded
# by a client bundle. Server values must never use a VITE_ prefix.
PORT=3001
NODE_ENV=development
# Database readiness probe (Phase 0). Leave UNSET for offline development.
# SUPABASE_URL=http://127.0.0.1:54321
# SUPABASE_ANON_KEY=<local-publishable-or-anon-key>
# LOCAL_DIAGNOSTIC_TOKEN=<private-random-secret-at-least-32-characters>

# Phase 2: runtime PostgreSQL for identity and tenancy.
# The login MUST be the restricted `aura_app` role created by the migrations,
# never a superuser, table owner or service-role key. Required in production.
# DATABASE_URL=postgres://aura_app:<password>@127.0.0.1:5432/postgres

# Phase 2: public application origin used for links and origin checks.
# APP_ORIGIN=http://127.0.0.1:3001

# Phase 2: local SMTP testing service. Production additionally requires TLS.
# SMTP_URL=smtp://127.0.0.1:2525
# EMAIL_FROM=AURA <no-reply@example.test>

# Optional tuning (defaults shown).
# SESSION_TTL_HOURS=12
# AUTH_TOKEN_TTL_MINUTES=60
# EMAIL_MAX_ATTEMPTS=3
# AUTH_MAX_FAILED_ATTEMPTS=8
# AUTH_REGISTER_HOURLY_LIMIT=20
# AUTH_LOGIN_IP_LIMIT=60
# AUTH_LOGIN_EMAIL_LIMIT=10

# Never set a service-role, payment or browser-exposed secret for this application.
